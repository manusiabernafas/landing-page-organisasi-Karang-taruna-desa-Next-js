# Salin menjadi .env.local lalu isi sesuai project Supabase kamu.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia, hanya dipakai di server (buat akun dari menu Pengaturan & skrip seed akun demo).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Connect -> Session pooler (hanya untuk `npm run db:run` di komputer lokal).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ORG_SLUG=pemuda-rw05-kwarasan

# Akun demo: password untuk 5 akun demo (min. 8 karakter), dipakai `npm run seed:users`.
DEMO_PASSWORD=
# true = tampilkan daftar akun demo di halaman login. Matikan (false) saat data asli dipakai.
NEXT_PUBLIC_DEMO_MODE=false
